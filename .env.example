# Configuración de Base de Datos MySQL (XAMPP por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kiosco_online
DB_USER=root
DB_PASS=

# Credenciales de Mercado Pago (reemplazar por las tuyas: TEST-... para pruebas)
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL base del proyecto en XAMPP
BASE_URL=http://localhost/2026/Antigravity
